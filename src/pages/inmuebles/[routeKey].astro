---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { visibleListingEntries } from '../../data/listings';
import { generatedListingEntries } from '../../data/listings/generated-batch';
import { canPublishListing, type Listing } from '../../lib/listings';
import { tourScripts } from '../../data/tours';
import { resolveShot } from '../../lib/guided-tour';
import '../../styles/property.css';
import { listingMetadata, listingSchema } from '../../lib/listing-seo';
import PropertyPreviewNotice from '../../components/property/PropertyPreviewNotice.astro';
import { propertyPreviewNotices } from '../../data/listings/preview-notices';
import type { ReviewIssue } from '../../lib/review-issues';

export function getStaticPaths() {
  const localPreview = import.meta.env.DEV || process.env.PROPERTY_DRAFT_PREVIEW === '1';
  return visibleListingEntries(localPreview).map(({ listing, readiness, draftNotice, reviewIssues }) => ({
    params: { routeKey: listing.routeKey },
    props: { listing, reviewIssues, pipelineManaged: generatedListingEntries.some((entry) => entry.listing.publicId === listing.publicId), isDraft: !canPublishListing(listing, readiness), draftNotice },
  }));
}

interface Props {
  listing: Listing;
  isDraft: boolean;
  pipelineManaged?: boolean;
  draftNotice: string;
  reviewIssues?: readonly ReviewIssue[];
}

const { listing, isDraft, draftNotice, pipelineManaged, reviewIssues } = Astro.props;
const isTeamContact = listing.contact.kind === 'team';
const contactFirstName = listing.contact.name.split(' ')[0];
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${basePath}${path.replace(/^\/+/, '')}`;
const siteOrigin = Astro.site ?? new URL('https://alfaropartners.es');
const path = `inmuebles/${listing.routeKey}/`;
const pageUrl = new URL(`${basePath}${path}`, siteOrigin).toString();
const imageUrl = new URL(withBase(listing.media.hero.large.url), siteOrigin).toString();
const price = new Intl.NumberFormat('es-ES', {
  style: 'currency',
  currency: listing.price.currency,
  maximumFractionDigits: 0,
}).format(listing.price.amount);
const { title: pageTitle, description: pageDescription } = listingMetadata(listing);
const visitHref = `mailto:${listing.contact.email}?subject=${encodeURIComponent(`Solicitud de visita privada · ${listing.publicId}`)}`;
const areaUnit = listing.area.measurement === 'usable'
  ? 'm² útiles'
  : listing.area.measurement === 'built' ? 'm² construidos' : 'm²';
const availabilityLabel = {
  available: 'Disponible para venta y visitas',
  reserved: 'Reservada',
  sold: 'Vendida',
  unconfirmed: 'Por confirmar antes de publicar',
}[listing.availability];
const placeLabel = `${listing.location.neighborhood} · ${listing.location.district} · ${listing.location.city}`;
const phoneLabel = listing.contact.phone.replace(/^\+34(\d{3})(\d{2})(\d{2})(\d{2})$/, '+34 $1 $2 $3 $4');
const galleryLabels = {
  living: 'Zona de estar',
  kitchen: 'Cocina y comedor',
  bedroom: 'Dormitorios',
  bathroom: 'Baños',
  detail: 'Detalles',
  circulation: 'Recorrido',
};
// The guided tour is the hub's one immersive route; every photographed stop links into its act.
const tour = tourScripts.find((script) => script.publicId === listing.publicId);
const tourHref = withBase(`inmuebles/${listing.routeKey}/reportaje/guiada/`);
const tourStops = (tour?.acts ?? []).flatMap((act) => {
  if (act.template === 'reveal' || act.template === 'arrival') return [{ id: act.id, label: act.label, image: resolveShot(listing, act.shot).image }];
  if (act.template === 'pair') return [{ id: act.id, label: act.label, image: resolveShot(listing, act.shots[0]).image }];
  return [];
});

// RealEstateListing is the page itself, not a second disconnected WebPage.
const homeUrl = new URL(basePath, siteOrigin).toString();
const seoSchema = isDraft ? undefined : listingSchema(listing, pageUrl, homeUrl, imageUrl);

---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  path={path}
  image={listing.media.hero.large.url}
  imageAlt={listing.media.hero.alt}
  imageWidth={listing.media.hero.large.width}
  imageHeight={listing.media.hero.large.height}
  robots={isDraft ? 'noindex, nofollow, noarchive' : 'index, follow, max-image-preview:large'}
  structuredData={seoSchema?.entities}
  pageSchema={seoSchema?.page}
  breadcrumbs={[
    { name: 'Inicio', path: '' },
    { name: 'Inmuebles', path: 'inmuebles/' },
    { name: listing.location.displayName, path },
  ]}
>
  <article class="property" data-lead-kind="property" data-property-id={listing.publicId}>
    {isDraft && (
      <PropertyPreviewNotice notice={pipelineManaged ? { pending: [draftNotice], issues: reviewIssues } : propertyPreviewNotices[listing.publicId] ?? { pending: [draftNotice] }} />
    )}

    <section id="inicio" class="property-hero" aria-labelledby="property-title">
      <picture class="property-hero__media">
        <source media="(max-width: 720px)" srcset={`${withBase(listing.media.hero.compact.url)} ${listing.media.hero.compact.width}w, ${withBase(listing.media.hero.large.url)} ${listing.media.hero.large.width}w`} sizes="150svh" />
        <img
          id="property-hero-image"
          src={withBase(listing.media.hero.large.url)}
          alt={listing.media.hero.alt}
          width={listing.media.hero.large.width}
          height={listing.media.hero.large.height}
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <div class="property-hero__shade" aria-hidden="true"></div>
      <button class="property-hero__pan-control" type="button" data-hero-pan-control aria-controls="property-hero-image" aria-label="Pausar movimiento de la imagen" aria-pressed="false" hidden>
        <svg data-hero-pan-pause width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M9 5v14M15 5v14" /></svg>
        <svg data-hero-pan-play width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="m8 5 11 7-11 7Z" /></svg>
      </button>
      <div class="property-hero__content wrap">
        <div class="property-hero__heading">
          <nav class="property-breadcrumb" aria-label="Ruta de navegación">
            <a href={withBase('')}>Inicio</a><span aria-hidden="true">/</span>
            <a href={withBase('inmuebles/')}>Inmuebles</a><span aria-hidden="true">/</span>
            <span aria-current="page">{listing.location.displayName}</span>
          </nav>
          <h1 id="property-title" class="display">{listing.editorial.title}</h1>
          <dl class="property-hero__facts" aria-label="Datos principales de la vivienda">
            <div><dt>Superficie</dt><dd>{listing.area.squareMeters} {areaUnit}</dd></div>
            <div><dt>Dormitorios</dt><dd>{listing.rooms.bedrooms}</dd></div>
            <div><dt>Baños</dt><dd>{listing.rooms.bathrooms}</dd></div>
            <div><dt>Zona</dt><dd>{listing.location.neighborhood} · {listing.location.district}</dd></div>
          </dl>
          {listing.area.measurement === 'unspecified' && <p class="property-hero__qualification">Tipo de superficie por verificar antes de publicar.</p>}
          <div class="property-hero__actions" data-cta-location="property-hero">
            <a class="property-action property-action--primary" href={visitHref}>Solicitar visita privada <span aria-hidden="true">↗</span></a>
            {tour
              ? <a class="property-action property-action--subtle" href={tourHref}>Visita guiada <span aria-hidden="true">↗</span></a>
              : <a class="property-action property-action--subtle" href="#la-vivienda">Explorar la vivienda <span aria-hidden="true">↓</span></a>}
            <a class="property-hero__gallery-link" href="#galeria" aria-label={`Ver las ${listing.media.gallery.length} fotografías`}>{listing.media.gallery.length} fotografías <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="property-hero__price">
          <span>Precio de venta</span>
          <strong>{price}</strong>
        </div>
      </div>
    </section>

    <section id="la-vivienda" class:list={["property-intro property-section", { "property-intro--editorial": listing.publicId === "ap-l8v3" }]} aria-labelledby="intro-title">
      <div class="wrap property-intro__body">
        <div>
          <p class="property__eyebrow">La vivienda</p>
          <h2 id="intro-title" class="display">{listing.editorial.introduction.title}</h2>
        </div>
        {listing.publicId === 'ap-l8v3' ? <div class="property-intro__copy">
          {listing.editorial.introduction.body.split('\n\n').map((paragraph) => <p>{paragraph}</p>)}
        </div> : <p>{listing.editorial.introduction.body}</p>}
      </div>
    </section>

    <section id="detalles" class="property-details property-section" aria-labelledby="details-title">
      <div class="wrap">
        <header class="property-section__head">
          <p class="property__eyebrow">Ficha</p>
          <h2 id="details-title" class="display">Datos de la vivienda.</h2>
        </header>
        <div class="property-details__facts">
          <dl class="property-details__highlights" aria-label="Superficie y distribución">
            <div class="property-details__area">
              <dt>Superficie</dt>
              <dd><strong>{listing.area.squareMeters}</strong><span>{areaUnit}</span></dd>
              {listing.area.measurement === 'unspecified' && <p>Tipo de superficie por confirmar.</p>}
            </div>
            <div><dt>Dormitorios</dt><dd>{listing.rooms.bedrooms}</dd></div>
            <div><dt>Baños</dt><dd>{listing.rooms.bathrooms}</dd></div>
          </dl>
          <dl class="property-details__specs">
            <div><dt>Tipo de vivienda</dt><dd>Piso</dd></div>
            <div><dt>Eficiencia energética</dt><dd class:list={[!listing.energy.rating && 'property-details__pending']}>{listing.energy.rating ? `Clase ${listing.energy.rating}${isDraft ? ' · según anuncio' : ''}` : 'Pendiente de verificar · borrador no publicable'}</dd></div>
            <div><dt>Disponibilidad</dt><dd class:list={{ 'property-details__pending': listing.availability === 'unconfirmed' }}>{availabilityLabel}</dd></div>
          </dl>
          {listing.features && listing.features.length > 0 && (
            <dl class="property-details__features" aria-label="Equipamiento y edificio">
              {listing.features.map((feature) => <div><dt>{feature.label}</dt><dd>{feature.value}</dd></div>)}
            </dl>
          )}
          {listing.energy.rating && (
            <p class="property-details__energy-note">
              {listing.energy.consumptionKwhPerSquareMeterYear !== undefined && <>Consumo: {listing.energy.consumptionKwhPerSquareMeterYear} kWh/m² al año. </>}
              {listing.energy.emissionsKgPerSquareMeterYear !== undefined && <>Emisiones: {listing.energy.emissionsKgPerSquareMeterYear} kg CO₂/m² al año. </>}
              {isDraft && 'Certificado pendiente de recibir y verificar.'}
            </p>
          )}
          <a class="property-details__gallery-link" href="#galeria">Ver las {listing.media.gallery.length} fotografías <span aria-hidden="true">↗</span></a>
        </div>
        <div id="ubicacion" class="property-details__location">
          <dl><div><dt>Ubicación pública</dt><dd>Barrio de {listing.location.neighborhood}, {listing.location.district} · {listing.location.city}</dd></div></dl>
          <a href={withBase('zonas/ibiza/')}>Descubrir el barrio <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    {tour && (
      <section id="visita-guiada" class="property-guided property-section" aria-labelledby="guided-title">
        <div class="wrap property-guided__head">
          <div>
            <p class="property__eyebrow">Visita guiada · {tourStops.length} estancias</p>
            <h2 id="guided-title" class="display">Recorre la vivienda antes de verla en persona.</h2>
            <p>{tour.description}</p>
          </div>
          <a class="property-action property-action--subtle" href={tourHref}>Empezar la visita <span aria-hidden="true">↗</span></a>
        </div>
        <ol class="property-guided__strip" aria-label="Entrar en la visita por una estancia">
          {tourStops.map((stop, index) => (
            <li>
              <a class="property-guided__card" href={`${tourHref}#${stop.id}`}>
                <img src={withBase(stop.image.compact.url)} alt={stop.image.alt}
                  width={stop.image.compact.width} height={stop.image.compact.height} loading="lazy" decoding="async" />
                <span><span>{String(index + 1).padStart(2, '0')}</span>{stop.label}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}

    <section id="galeria" class="property-gallery property-section" aria-labelledby="gallery-title">
      <div class="wrap property-gallery__head">
        <div><p class="property__eyebrow">Galería completa</p><h2 id="gallery-title" class="display">Fotografías para mirar con calma.</h2></div>
        <p>{listing.media.gallery.length} fotografías</p>
      </div>
      <div class="wrap property-gallery__grid">
        {listing.media.gallery.map((photo, index) => (
          <figure class="property-gallery__item">
            <a
              href={withBase(photo.large.url)}
              target="_blank"
              rel="noopener"
              aria-label={`Ampliar fotografía ${index + 1} de ${listing.media.gallery.length}: ${photo.alt}`}
              data-gallery-trigger
              data-index={index}
              data-large={withBase(photo.large.url)}
              data-alt={photo.alt}
              data-width={photo.large.width}
              data-height={photo.large.height}
            >
              <img
                src={withBase(photo.compact.url)}
                srcset={`${withBase(photo.compact.url)} ${photo.compact.width}w, ${withBase(photo.large.url)} ${photo.large.width}w`}
                sizes="(max-width: 760px) 50vw, 33vw"
                alt={photo.alt}
                width={photo.compact.width}
                height={photo.compact.height}
                loading="lazy"
                decoding="async"
              />
              <svg class="property-gallery__inspect" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5M8 10.5h5M10.5 8v5" />
              </svg>
            </a>
            <figcaption>
              <span>{String(index + 1).padStart(2, '0')}</span>
              {listing.media.gallery[index - 1]?.scene !== photo.scene && <span>{galleryLabels[photo.scene]}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <a class="property-back-top" href="#inicio" data-property-back-top>
      <span aria-hidden="true">↑</span><span>Volver arriba</span>
    </a>

    <section id="visita" class="property-contact property-section" aria-labelledby="contact-title" data-cta-location="property-contact">
      <div class:list={["wrap", "property-contact__grid", { "property-contact__grid--team": isTeamContact }]}>
        <div class="property-contact__copy">
          <p class="property__eyebrow">Visita privada</p>
          <h2 id="contact-title" class="display">{isTeamContact ? 'Conoce la vivienda con Alfaro & Partners.' : `Conoce la vivienda con ${contactFirstName}.`}</h2>
          <p>{isTeamContact ? 'Contacta con el equipo para consultar la disponibilidad y organizar una visita privada.' : 'Es el profesional responsable de esta vivienda. Escríbele para concertar una visita privada.'}</p>
          <a class="property-action property-action--primary" href={visitHref}>Solicitar visita privada <span aria-hidden="true">↗</span></a>
          <a class="property-contact__phone" href={`tel:${listing.contact.phone}`}>O llamar al {phoneLabel}</a>
        </div>
        <aside class="property-contact__agent" aria-label={isTeamContact ? 'Equipo de contacto' : 'Profesional responsable'}>
          {listing.contact.portrait && <div class="property-contact__portrait">
            <img
              src={withBase(listing.contact.portrait.url)}
              alt={`Retrato de ${listing.contact.name}`}
              width={listing.contact.portrait.width}
              height={listing.contact.portrait.height}
              loading="lazy"
              decoding="async"
            />
          </div>
          }
          <div class="property-contact__identity">
            <span>{isTeamContact ? 'Equipo de contacto' : 'Profesional responsable'}</span>
            <strong>{listing.contact.name}</strong>
            <p>{listing.contact.role}</p>
            {listing.contact.profileUrl && <a href={withBase(listing.contact.profileUrl)}>Conocer a {contactFirstName} <span aria-hidden="true">↗</span></a>}
          </div>
        </aside>
      </div>
    </section>
  </article>

  <dialog id="property-photo-viewer" class="property-viewer" aria-label="Fotografía ampliada">
    <div class="property-viewer__bar">
      <span data-gallery-count aria-hidden="true"></span>
      <button type="button" data-gallery-close aria-label="Cerrar fotografía">Cerrar ×</button>
    </div>
    <div class="property-viewer__stage" data-gallery-stage data-state="loading">
      <img data-gallery-image alt="" width="1800" height="1201" decoding="async" hidden />
      <div class="property-viewer__feedback">
        <p data-gallery-status role="status" aria-live="polite" aria-atomic="true"></p>
        <div class="property-viewer__recovery" data-gallery-recovery hidden>
          <button type="button" data-gallery-retry>Reintentar</button>
          <a data-gallery-error-original target="_blank" rel="noopener">Abrir fotografía ↗</a>
        </div>
      </div>
    </div>
    <div class="property-viewer__bar property-viewer__bar--bottom">
      <div class="property-viewer__meta">
        <p data-gallery-caption></p>
        <a data-gallery-original target="_blank" rel="noopener" hidden>Ver tamaño completo ↗</a>
      </div>
      <div>
        <button type="button" data-gallery-previous aria-label="Fotografía anterior">←</button>
        <button type="button" data-gallery-next aria-label="Fotografía siguiente">→</button>
      </div>
    </div>
  </dialog>

  <script>
    import { initializePropertyHeroPan } from '../../lib/property-hero-pan';

    const heroForPan = document.querySelector<HTMLElement>('.property-hero');
    if (heroForPan) {
      const disposePan = initializePropertyHeroPan(heroForPan);
      document.addEventListener('astro:before-swap', disposePan, { once: true });
    }

    // Keep the global floating WhatsApp shortcut out of the hero's price/CTA area.
    // On this route, the fixed shortcut appears only after the hero leaves view.
    // Back-to-top stays after the gallery on phones and without JS; only desktop floats it.
    const propertyHero = document.querySelector<HTMLElement>('.property-hero');
    const floatingWhatsApp = document.querySelector<HTMLAnchorElement>('.float-wa');
    const backTop = document.querySelector<HTMLAnchorElement>('[data-property-back-top]');
    backTop?.classList.add('is-enhanced');
    if (propertyHero && (floatingWhatsApp || backTop)) {
      const heroObserver = new IntersectionObserver(([entry]) => {
        floatingWhatsApp?.classList.toggle('is-property-visible', !entry.isIntersecting);
        backTop?.classList.toggle('is-visible', !entry.isIntersecting);
      });
      heroObserver.observe(propertyHero);
    }

    const viewer = document.querySelector<HTMLDialogElement>('#property-photo-viewer');
    const triggers = [...document.querySelectorAll<HTMLAnchorElement>('[data-gallery-trigger]')];
    const fullImage = viewer?.querySelector<HTMLImageElement>('[data-gallery-image]');
    const counter = viewer?.querySelector<HTMLElement>('[data-gallery-count]');
    const caption = viewer?.querySelector<HTMLElement>('[data-gallery-caption]');
    const stage = viewer?.querySelector<HTMLElement>('[data-gallery-stage]');
    const photoStatus = viewer?.querySelector<HTMLElement>('[data-gallery-status]');
    const recovery = viewer?.querySelector<HTMLElement>('[data-gallery-recovery]');
    const original = viewer?.querySelector<HTMLAnchorElement>('[data-gallery-original]');
    const errorOriginal = viewer?.querySelector<HTMLAnchorElement>('[data-gallery-error-original]');
    let requested = 0;
    let requestId = 0;
    let loader: HTMLImageElement | null = null;
    let loadTimeout: number | undefined;
    let opener: HTMLAnchorElement | null = null;

    const cancelLoad = () => {
      requestId += 1;
      window.clearTimeout(loadTimeout);
      if (loader) { loader.onload = null; loader.onerror = null; }
      loader = null;
    };

    const show = (index: number) => {
      if (!viewer?.open || !triggers.length || !fullImage || !counter || !caption || !stage || !photoStatus || !recovery || !original || !errorOriginal) return;
      cancelLoad();
      requested = (index + triggers.length) % triggers.length;
      const item = triggers[requested];
      const url = item.dataset.large ?? item.href;
      const id = requestId;
      const label = `fotografía ${requested + 1} de ${triggers.length}`;
      stage.dataset.state = 'loading';
      photoStatus.textContent = `Cargando ${label}…`;
      fullImage.setAttribute('aria-busy', 'true');
      recovery.hidden = true;
      errorOriginal.href = url;
      // Keep the previous image, caption and original link coherent until the new image loads.
      const image = new Image();
      loader = image;
      const fail = () => {
        if (id !== requestId || !viewer.open) return;
        cancelLoad();
        stage.dataset.state = 'error';
        fullImage.setAttribute('aria-busy', 'false');
        photoStatus.textContent = `No se ha podido cargar la ${label}. Puedes reintentar o abrirla por separado.`;
        recovery.hidden = false;
      };
      image.onload = () => {
        if (id !== requestId || !viewer.open) return;
        if (!image.naturalWidth) { fail(); return; }
        window.clearTimeout(loadTimeout);
        loader = null;
        fullImage.src = url;
        fullImage.alt = item.dataset.alt ?? '';
        fullImage.width = Number(item.dataset.width) || image.naturalWidth;
        fullImage.height = Number(item.dataset.height) || image.naturalHeight;
        fullImage.hidden = false;
        fullImage.setAttribute('aria-busy', 'false');
        counter.textContent = `${String(requested + 1).padStart(2, '0')} / ${String(triggers.length).padStart(2, '0')}`;
        caption.textContent = item.dataset.alt ?? '';
        original.href = url;
        original.hidden = false;
        stage.dataset.state = 'ready';
        photoStatus.textContent = `Fotografía ${requested + 1} de ${triggers.length}. ${item.dataset.alt ?? ''}`;
      };
      image.onerror = fail;
      loadTimeout = window.setTimeout(fail, 20000);
      image.src = url;
    };

    triggers.forEach((item, index) => item.addEventListener('click', (event) => {
      if (!viewer?.showModal) return; // Native link remains a functional fallback.
      event.preventDefault();
      opener = item;
      if (!viewer.open) {
        if (counter) counter.textContent = `${triggers.length} fotografías`;
        viewer.showModal();
      }
      document.body.classList.add('property-viewer-open');
      show(index);
    }));

    const closeViewer = () => { cancelLoad(); viewer?.close(); };
    viewer?.querySelector('[data-gallery-close]')?.addEventListener('click', closeViewer);
    viewer?.querySelector('[data-gallery-previous]')?.addEventListener('click', () => show(requested - 1));
    viewer?.querySelector('[data-gallery-next]')?.addEventListener('click', () => show(requested + 1));
    viewer?.querySelector('[data-gallery-retry]')?.addEventListener('click', () => show(requested));
    viewer?.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') { event.preventDefault(); show(requested - 1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); show(requested + 1); }
    });
    viewer?.addEventListener('cancel', cancelLoad);
    viewer?.addEventListener('click', (event) => { if (event.target === viewer) closeViewer(); });
    viewer?.addEventListener('close', () => {
      // A queued close event from an earlier session must not cancel a rapid reopen.
      if (viewer.open) return;
      cancelLoad();
      if (fullImage) { fullImage.hidden = true; fullImage.removeAttribute('src'); }
      if (caption) caption.textContent = '';
      if (photoStatus) photoStatus.textContent = '';
      if (original) original.hidden = true;
      document.body.classList.remove('property-viewer-open');
      opener?.focus();
    });
  </script>
</BaseLayout>
