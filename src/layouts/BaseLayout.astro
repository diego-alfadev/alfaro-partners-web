---
import '../styles/global.css';
import { Icon } from 'astro-icon/components';
import { BUSINESS_INFO } from '../lib/constants';

interface Props {
  title: string;
  description?: string;
  path?: string;
  image?: string;
  type?: 'website' | 'article';
  robots?: string;
}

const {
  title,
  description = 'José María Alfaro - Representación Inmobiliaria Premium. Más de 20 años protegiendo tus intereses patrimoniales.',
  path = '',
  image = BUSINESS_INFO.site.defaultImage,
  type = 'website',
  robots = 'index, follow',
} = Astro.props;

const {
  booking,
  phone: CONTACT_PHONE,
  email: CONTACT_EMAIL,
  legal: LEGAL_LINKS,
  social,
  site,
} = BUSINESS_INFO;

const siteOrigin = Astro.site ?? new URL(site.origin);
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const cleanPath = (value: string) => value.replace(/^\/+/, '');
const withBase = (value: string) => `${basePath}${cleanPath(value)}`;
const canonicalUrl = new URL(`${basePath}${cleanPath(path)}`, siteOrigin).toString();
const imageUrl = new URL(withBase(image), siteOrigin).toString();
const homeUrl = new URL(basePath, siteOrigin).toString();
const isPngImage = imageUrl.endsWith('.png');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  name: BUSINESS_INFO.name,
  image: imageUrl,
  url: homeUrl,
  telephone: `+${CONTACT_PHONE}`,
  email: CONTACT_EMAIL,
  description: 'Representación inmobiliaria premium y protección del patrimonio. Más de 20 años de experiencia impulsando las buenas prácticas.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Madrid',
    addressCountry: 'ES',
  },
  memberOf: [
    {
      '@type': 'Organization',
      name: 'FAI',
      url: BUSINESS_INFO.sites.fai,
    },
  ],
  founder: {
    '@type': 'Person',
    name: BUSINESS_INFO.name,
  },
};
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
  
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:secure_url" content={imageUrl} />
  {isPngImage && <meta property="og:image:type" content="image/png" />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="Alfaro & Partners" />
  <meta property="og:locale" content="es_ES" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body class="obsidian">
  <header class="site-header">
    <div class="site-header__inner wrap">
      <a href={withBase('')} class="brand" aria-label="Alfaro & Partners">
        <img class="brand__logo" src={withBase('images/logo-white.png')} alt="Alfaro & Partners"
             onerror="this.outerHTML='<span class=\'brand__wordmark\'>ALFARO <span class=\'amp\'>&amp;</span> PARTNERS</span>'">
      </a>
      <nav class="nav" aria-label="Principal">
        <a class="nav__link" href={withBase('#firma')}>La Firma</a>
        <a class="nav__link" href={withBase('#servicios')}>Servicios</a>
        <a class="nav__link" href={withBase('zonas/')}>Zonas</a>
        <a class="nav__link" href={withBase('#contacto')}>Contacto</a>
      </nav>
      <a class="btn btn--ghost" href={booking.url} target="_blank" rel="noopener noreferrer">Reservar Cita</a>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap site-footer__inner">
      <div class="site-footer__brand">
        <span class="brand__wordmark">ALFARO <span class="amp">&amp;</span> PARTNERS</span>
        <p>Representación inmobiliaria en Madrid centro. Personas antes que operaciones.</p>
      </div>

      <div class="site-footer__cols">
        <div>
          <p class="site-footer__heading">Explorar</p>
          <div class="site-footer__links">
            <a href={withBase('#servicios')}>Servicios</a>
            <a href={withBase('zonas/')}>Zonas</a>
            <a href={booking.url} target="_blank" rel="noopener noreferrer">Reservar cita</a>
          </div>
        </div>

        <div>
          <p class="site-footer__heading">Conectar</p>
          <div class="social-cards social-cards--footer">
            <a class="social-card social-card--wa" href={social.whatsapp} target="_blank" rel="noopener noreferrer">
              <span class="social-card__icon" aria-hidden="true">
                <Icon name="simple-icons:whatsapp" />
              </span>
              <span>
                <strong>WhatsApp</strong>
                <small>Respuesta directa</small>
              </span>
            </a>
            <a class="social-card" href={social.linkedin} target="_blank" rel="noopener noreferrer">
              <span class="social-card__icon" aria-hidden="true">
                <Icon name="simple-icons:linkedin" />
              </span>
              <span>
                <strong>LinkedIn</strong>
                <small>Perfil profesional</small>
              </span>
            </a>
          </div>
        </div>

        <div>
          <p class="site-footer__heading">Legal</p>
          <div class="site-footer__links">
            <a href={withBase(LEGAL_LINKS.notice)}>Aviso legal</a>
            <a href={withBase(LEGAL_LINKS.privacy)}>Privacidad</a>
            <a href={withBase(LEGAL_LINKS.cookies)}>Cookies</a>
            <a href={social.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
          </div>
        </div>
      </div>

      <p class="site-footer__fineprint">© {new Date().getFullYear()} Alfaro &amp; Partners · Todos los derechos reservados</p>
    </div>
  </footer>

  <a class="float-wa" href={social.whatsapp} aria-label="WhatsApp directo" target="_blank" rel="noopener noreferrer">
    <Icon name="simple-icons:whatsapp" />
  </a>
</body>
</html>
