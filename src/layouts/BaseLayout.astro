---
import '../styles/global.css';
import { BUSINESS_INFO } from '../lib/constants';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'José María Alfaro - Representación Inmobiliaria Premium. Más de 20 años protegiendo tus intereses patrimoniales.' } = Astro.props;
const { calendarUrl: CALENDAR_URL, phone: CONTACT_PHONE, email: CONTACT_EMAIL } = BUSINESS_INFO;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <meta name="generator" content={Astro.generator} />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
  
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="/images/alfaro-hero.png" />
  <meta name="twitter:card" content="summary_large_image" />

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "RealEstateAgent",
      "name": "José María Alfaro",
      "image": "https://alfaroandpartners.com/images/alfaro-hero.png",
      "url": "https://alfaroandpartners.com",
      "telephone": `+${CONTACT_PHONE}`,
      "email": CONTACT_EMAIL,
      "description": "Representación inmobiliaria premium y protección del patrimonio. Más de 20 años de experiencia impulsando las buenas prácticas.",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Madrid",
        "addressCountry": "ES"
      },
      "memberOf": [
        {
          "@type": "Organization",
          "name": "FAI",
          "url": "https://fainmo.es"
        }
      ],
      "founder": {
        "@type": "Person",
        "name": "José María Alfaro"
      }
    }
  </script>
</head>
<body class="obsidian">
  <header class="site-header">
    <div class="site-header__inner wrap">
      <a href="/" class="brand" aria-label="Alfaro & Partners">
        <img class="brand__logo" src="/images/logo-white.png" alt="Alfaro & Partners"
             onerror="this.outerHTML='<span class=\'brand__wordmark\'>ALFARO <span class=\'amp\'>&amp;</span> PARTNERS</span>'">
      </a>
      <nav class="nav" aria-label="Principal">
        <a class="nav__link" href="#firma">La Firma</a>
        <a class="nav__link" href="#servicios">Servicios</a>
        <a class="nav__link" href="#contacto">Contacto</a>
      </nav>
      <a class="btn btn--ghost" href={CALENDAR_URL} target="_blank" rel="noopener noreferrer">Reservar Cita</a>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap site-footer__inner">
      <p>© {new Date().getFullYear()} Alfaro &amp; Partners · Todos los derechos reservados</p>
      <div class="site-footer__links">
        <a href="#">Aviso legal</a>
        <a href="#">Privacidad</a>
        <a href="#">Cookies</a>
      </div>
    </div>
  </footer>

  <a class="float-wa" href={`https://wa.me/${CONTACT_PHONE}`} aria-label="WhatsApp directo" target="_blank" rel="noopener noreferrer">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.586-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.595 5.39l-.999 3.648 3.893-1.737z"/>
    </svg>
  </a>
</body>
</html>
