---
import '../styles/global.css';
import { Icon } from 'astro-icon/components';
import { Font } from 'astro:assets';
import { BUSINESS_INFO } from '../lib/constants';

interface Breadcrumb {
  name: string;
  path: string;
}

interface Props {
  title: string;
  description?: string;
  path?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  robots?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  breadcrumbs?: Breadcrumb[];
}

const {
  title,
  description = 'José María Alfaro - Representación Inmobiliaria Premium. Más de 20 años protegiendo tus intereses patrimoniales.',
  path = '',
  image = BUSINESS_INFO.site.defaultImage,
  imageAlt = 'Alfaro & Partners — representación inmobiliaria en Madrid',
  type = 'website',
  robots = 'index, follow, max-image-preview:large',
  structuredData,
  breadcrumbs,
} = Astro.props;

const {
  analytics,
  booking,
  phone: CONTACT_PHONE,
  address: OFFICE,
  openingHours: OFFICE_HOURS,
  legal: LEGAL_LINKS,
  social,
  site,
} = BUSINESS_INFO;

const siteOrigin = Astro.site ?? new URL(site.origin);
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const cleanPath = (value: string) => value.replace(/^\/+/, '');
const withBase = (value: string) => `${basePath}${cleanPath(value)}`;
const canonicalUrl = new URL(`${basePath}${cleanPath(path)}`, siteOrigin).toString();
const imageUrl = new URL(withBase(image), siteOrigin).toString();
const homeUrl = new URL(basePath, siteOrigin).toString();
const isPngImage = imageUrl.endsWith('.png');
const googleTagId = import.meta.env.PROD ? analytics.googleTagId : undefined;

// SEO hardening (SDD alfaro-seo-hardening, Phase 6a): one @graph per page,
// linked via @id references instead of the previous two disconnected
// <script> blocks (organization schema here + a second one per page).
// `email` now ships: the corporate address arrived (R1, answered 18 Aug), so
// the reason it was withheld -- a personal gmail sitting in a business node --
// no longer applies.
const organizationNode = {
  '@type': 'RealEstateAgent',
  '@id': `${homeUrl}#organization`,
  name: BUSINESS_INFO.brandName,
  alternateName: 'Alfaro and Partners',
  image: imageUrl,
  url: homeUrl,
  telephone: `+${CONTACT_PHONE}`,
  email: BUSINESS_INFO.email,
  description: 'Representación inmobiliaria premium y protección del patrimonio. Más de 20 años de experiencia impulsando las buenas prácticas.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: OFFICE.street,
    addressLocality: OFFICE.locality,
    addressRegion: OFFICE.region,
    postalCode: OFFICE.postalCode,
    addressCountry: OFFICE.country,
  },
  // Sunday is simply absent rather than declared closed -- that is how
  // schema.org expresses "not open", and Google reads it that way.
  openingHoursSpecification: OFFICE_HOURS.map((slot) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: slot.days,
    opens: slot.opens,
    closes: slot.closes,
  })),
  areaServed: {
    '@type': 'City',
    name: 'Madrid',
  },
  sameAs: [social.instagram, social.linkedin],
  memberOf: [
    {
      '@type': 'Organization',
      name: 'FAI',
      url: BUSINESS_INFO.sites.fai,
    },
  ],
  founder: { '@id': `${homeUrl}#founder` },
};

// The E-E-A-T asset: José María Alfaro's FAI presidency belongs on the
// Person node itself, not only referenced from RealEstateAgent.memberOf.
const founderNode = {
  '@type': 'Person',
  '@id': `${homeUrl}#founder`,
  name: BUSINESS_INFO.name,
  jobTitle: 'Presidente de la Federación Nacional de Asociaciones Inmobiliarias (FAI)',
  worksFor: { '@id': `${homeUrl}#organization` },
  memberOf: {
    '@type': 'Organization',
    name: 'FAI',
    url: BUSINESS_INFO.sites.fai,
  },
  sameAs: [social.linkedin, social.instagram],
  knowsAbout: ['Representación inmobiliaria', 'Herencias inmobiliarias', 'Mercado de vivienda en España'],
};

const breadcrumbNode = breadcrumbs?.length
  ? {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: breadcrumbs.map((crumb, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: crumb.name,
        item: new URL(`${basePath}${cleanPath(crumb.path)}`, siteOrigin).toString(),
      })),
    }
  : null;

const webPageNode = {
  '@type': 'WebPage',
  '@id': `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: title,
  isPartOf: { '@id': `${homeUrl}#organization` },
  ...(breadcrumbNode ? { breadcrumb: { '@id': breadcrumbNode['@id'] } } : {}),
};

// `structuredData` accepts either a single node, an array of nodes, or a
// full `{'@context', '@graph': [...]}` object (the shape the three existing
// callers already pass) -- unwrapped and merged into the one page @graph.
// Backward compatible: none of the three current callers need to change.
const pageNodes = structuredData
  ? (Array.isArray(structuredData) ? structuredData : [structuredData]).flatMap((entry) => {
      const graphField = (entry as Record<string, unknown>)?.['@graph'];
      return Array.isArray(graphField) ? (graphField as Record<string, unknown>[]) : [entry];
    })
  : [];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [organizationNode, founderNode, webPageNode, breadcrumbNode, ...pageNodes].filter(Boolean),
};
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />
  <link rel="canonical" href={canonicalUrl} />
  <!-- Libre Baskerville is self-hosted (SIL OFL) via Astro's fonts config --
       see astro.config.mjs. Satoshi stays remote: Fontshare's Free Font
       EULA prohibits self-hosting/redistributing the font files. -->
  <Font cssVariable="--font-display-src" preload />
  <link rel="preconnect" href="https://api.fontshare.com" />
  <link
    rel="stylesheet"
    href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700&display=swap"
  />
  <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
  <link rel="alternate icon" href={withBase('favicon.ico')} sizes="any" />
  <link rel="icon" type="image/png" href={withBase('favicon-32.png')} sizes="32x32" />
  <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:secure_url" content={imageUrl} />
  <meta property="og:image:alt" content={imageAlt} />
  {isPngImage && <meta property="og:image:type" content="image/png" />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="Alfaro & Partners" />
  <meta property="og:locale" content="es_ES" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />
  <meta name="twitter:image:alt" content={imageAlt} />

  {googleTagId && <script async src={`https://www.googletagmanager.com/gtag/js?id=${googleTagId}`}></script>}
  {googleTagId && (
    <script type="text/javascript" define:vars={{ googleTagId }}>
      // gtag must be assigned onto window explicitly. Astro wraps any script
      // using define:vars in an IIFE, so a bare `function gtag(){}` stays
      // local to that closure and never reaches the global scope -- which
      // silently disables every consumer that checks for window.gtag,
      // including the lead-tracking listener at the bottom of this file.
      window.dataLayer = window.dataLayer || [];
      window.gtag = function gtag(){window.dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', googleTagId);
    </script>
  )}

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body class="obsidian">
  <header class="site-header">
    <div class="site-header__inner wrap">
      <a href={withBase('')} class="brand" aria-label="Alfaro & Partners">
        <img class="brand__logo" src={withBase('images/logo-blanco.svg')} alt="Alfaro & Partners" width="718" height="99">
      </a>
      <nav class="nav" aria-label="Principal">
        <a class="nav__link" href={withBase('#firma')}>La Firma</a>
        <a class="nav__link" href={withBase('#servicios')}>Servicios</a>
          <a class="nav__link" href={withBase('actualidad/')}>Actualidad</a>
        <a class="nav__link" href={withBase('zonas/')}>Zonas</a>
        <a class="nav__link" href={withBase('partners/')}>Partners</a>
        <a class="nav__link" href={withBase('#contacto')}>Contacto</a>
      </nav>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation">
        <span>Menú</span>
        <span class="nav-toggle__icon" aria-hidden="true"><span></span><span></span></span>
      </button>
      <a class="btn btn--ghost header-cta" href={booking.url} target="_blank" rel="noopener noreferrer">Reservar Cita</a>
      <nav id="mobile-navigation" class="nav-panel" aria-label="Principal móvil" hidden>
        <div class="nav-panel__inner wrap">
          <a class="nav-panel__link" href={withBase('#firma')}>La Firma</a>
          <a class="nav-panel__link" href={withBase('#servicios')}>Servicios</a>
          <a class="nav-panel__link" href={withBase('actualidad/')}>Actualidad</a>
          <a class="nav-panel__link" href={withBase('zonas/')}>Zonas</a>
          <a class="nav-panel__link" href={withBase('partners/')}>Partners</a>
          <a class="nav-panel__link" href={withBase('#contacto')}>Contacto</a>
          <a class="btn btn--ghost nav-panel__cta" href={booking.url} target="_blank" rel="noopener noreferrer">Reservar Cita</a>
        </div>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap site-footer__inner">
      <div class="site-footer__brand">
        <img class="site-footer__logo" src={withBase('images/logo-blanco.svg')} alt="Alfaro & Partners" width="718" height="99">
        <p>Representación inmobiliaria en Madrid centro. Criterio, transparencia y defensa real de tus intereses.</p>
      </div>

      <div class="site-footer__cols">
        <div>
          <p class="site-footer__heading">Explorar</p>
          <div class="site-footer__links">
            <a href={withBase('#servicios')}>Servicios</a>
            <a href={withBase('actualidad/')}>Actualidad</a>
            <a href={withBase('herencias-inmobiliarias/')}>Herencias inmobiliarias</a>
            <a href={withBase('zonas/')}>Zonas</a>
            <a href={withBase('partners/')}>Partners</a>
            <a href={booking.url} target="_blank" rel="noopener noreferrer">Reservar cita</a>
          </div>
        </div>

        <div>
          <p class="site-footer__heading">Conectar</p>
          <div class="social-cards social-cards--footer">
            <a class="social-card social-card--wa" href={social.whatsapp} target="_blank" rel="noopener noreferrer">
              <span class="social-card__icon" aria-hidden="true">
                <Icon name="simple-icons:whatsapp" />
              </span>
              <span>
                <strong>WhatsApp</strong>
                <small>Respuesta directa</small>
              </span>
            </a>
            <a class="social-card" href={social.linkedin} target="_blank" rel="noopener noreferrer">
              <span class="social-card__icon" aria-hidden="true">
                <Icon name="simple-icons:linkedin" />
              </span>
              <span>
                <strong>LinkedIn</strong>
                <small>Perfil profesional</small>
              </span>
            </a>
            <a class="social-card social-card--ig" href={social.instagram} target="_blank" rel="noopener noreferrer">
              <span class="social-card__icon" aria-hidden="true">
                <Icon name="simple-icons:instagram" />
              </span>
              <span>
                <strong>Instagram</strong>
                <small>Alfaro &amp; Partners</small>
              </span>
            </a>
          </div>
        </div>

        <div>
          <p class="site-footer__heading">Despacho</p>
          {/* Visible NAP: Google weighs an address a person can read, not
              only one in the markup. Must stay identical to the Google
              Business listing and to the PostalAddress above. */}
          <address class="site-footer__address">
            <span>{OFFICE.street}</span>
            <span>{OFFICE.postalCode} {OFFICE.locality} · {OFFICE.district}</span>
            <a href={`tel:+${CONTACT_PHONE}`}>+34 672 50 46 42</a>
            <span class="site-footer__hours">Lun a vie, 10:30–19:00 · Sáb, 10:30–13:30</span>
          </address>
        </div>

        <div>
          <p class="site-footer__heading">Legal</p>
          <div class="site-footer__links">
            <a href={withBase(LEGAL_LINKS.notice)}>Aviso legal</a>
            <a href={withBase(LEGAL_LINKS.privacy)}>Privacidad</a>
            <a href={withBase(LEGAL_LINKS.cookies)}>Cookies</a>
          </div>
        </div>
      </div>

      <p class="site-footer__fineprint">© {new Date().getFullYear()} Alfaro &amp; Partners · Todos los derechos reservados</p>
    </div>
  </footer>

  <a class="float-wa" href={social.whatsapp} aria-label="WhatsApp" target="_blank" rel="noopener noreferrer">
    <Icon name="simple-icons:whatsapp" />
  </a>

  <script>
    const header = document.querySelector('.site-header');
    const navToggle = document.querySelector('.nav-toggle');
    const navPanel = document.querySelector('#mobile-navigation');

    const setNavigationOpen = (open) => {
      if (!(navToggle instanceof HTMLButtonElement) || !(navPanel instanceof HTMLElement)) return;
      navToggle.setAttribute('aria-expanded', String(open));
      navPanel.hidden = !open;
      document.body.classList.toggle('nav-open', open);
    };

    navToggle?.addEventListener('click', () => {
      setNavigationOpen(navToggle.getAttribute('aria-expanded') !== 'true');
    });

    navPanel?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setNavigationOpen(false));
    });

    document.addEventListener('click', (event) => {
      if (navToggle?.getAttribute('aria-expanded') !== 'true') return;
      if (event.target instanceof Node && !header?.contains(event.target)) setNavigationOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || navToggle?.getAttribute('aria-expanded') !== 'true') return;
      setNavigationOpen(false);
      if (navToggle instanceof HTMLButtonElement) navToggle.focus();
    });

    window.matchMedia('(min-width: 1201px)').addEventListener('change', (event) => {
      if (event.matches) setNavigationOpen(false);
    });

    // GA4 lead tracking: one delegated capture-phase listener covers every
    // current and future CTA. All CTAs open target="_blank", so the document is
    // never unloaded -- no preventDefault/event_callback needed.
    //
    // Only `generate_lead` is emitted here. Generic outbound clicks and file
    // downloads are deliberately NOT tracked: GA4 Enhanced Measurement already
    // collects both by default, and duplicating them double-counts every click.
    // tel: and mailto: are the opposite case -- Enhanced Measurement ignores
    // them entirely, so without this they are invisible.
    document.addEventListener('click', (event) => {
      if (typeof window.gtag !== 'function') return;
      if (!(event.target instanceof Element)) return;

      const link = event.target.closest('a[href]');
      if (!(link instanceof HTMLAnchorElement)) return;

      let url;
      try {
        url = new URL(link.href, window.location.href);
      } catch {
        return;
      }

      // mailto: is deliberately NOT a lead. It started as a legal-pages-only
      // link (data-protection enquiries, not prospects), and although /partners/
      // and the partner profiles now add their own, none of them is a client
      // asking for representation either. They still get recorded, just under an
      // event that is not marked as a key event in GA4.
      const intent =
        url.hostname === 'calendar.app.google' ? ['generate_lead', 'booking'] :
        url.hostname === 'wa.me' || url.hostname === 'api.whatsapp.com' ? ['generate_lead', 'whatsapp'] :
        url.protocol === 'tel:' ? ['generate_lead', 'phone'] :
        url.protocol === 'mailto:' ? ['contact_click', 'email'] :
        null;

      if (!intent) return;

      const [eventName, method] = intent;

      // A partner application travels on the same WhatsApp link as a client
      // enquiry, so the URL cannot tell them apart. Counting it as generate_lead
      // would inflate the conversion number with people offering services
      // instead of asking for them.
      const isPartnerApplication = link.closest('[data-lead-kind="partner"]') !== null;

      window.gtag('event', isPartnerApplication ? 'partner_application' : eventName, {
        method,
        link_url: url.href,
        link_text: link.textContent?.trim() ?? '',
        cta_location:
          link.closest('[data-cta-location]')?.getAttribute('data-cta-location') ??
          link.closest('section[id]')?.id ??
          link.closest('header,footer')?.tagName.toLowerCase() ??
          'unknown',
      });
    }, true);
  </script>
</body>
</html>
