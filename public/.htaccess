Options -Indexes +FollowSymLinks

DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # SEO hardening (SDD alfaro-seo-hardening, Phase 7): Libre Baskerville is
  # self-hosted (fonts.googleapis.com / fonts.gstatic.com dropped). Satoshi
  # stays remote via Fontshare (api.fontshare.com / cdn.fontshare.com kept) --
  # its EULA prohibits self-hosting the font files. 'unsafe-inline' on
  # style-src must stay: Astro's <Font> component emits an inline <style>.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://api.fontshare.com; font-src 'self' https://cdn.fontshare.com; img-src 'self' data: https: https://www.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  # SEO hardening (SDD alfaro-seo-hardening, Phase 7) -- self-hosted Libre
  # Baskerville woff2 files need the same long-lived cache as other assets.
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # SEO hardening (SDD alfaro-seo-hardening, Phase 7): woff2|woff|ttf added --
  # this pattern previously excluded self-hosted font files from the
  # immutable cache header entirely (they would have shipped uncacheable).
  <FilesMatch "\.(css|js|png|jpg|jpeg|webp|svg|ico|woff2|woff|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# SEO hardening (SDD alfaro-seo-hardening, Phase 2) — www -> canonical non-www
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Host-keyed only. Apache reads %{HTTP_HOST} verbatim from the request
  # line -- it is never proxy-rewritten, so this condition cannot re-fire
  # after its own redirect (the second request arrives with
  # Host: alfaropartners.es, which no longer matches). Zero loop risk.
  #
  # This rule also absorbs the http/https upgrade for www: the target is
  # hardcoded to https:// regardless of the incoming scheme, so www never
  # needs to rely on %{HTTPS} -- which is just as well, since it isn't
  # reliable on that vhost (see the note on the rule below).
  RewriteCond %{HTTP_HOST} ^www\.alfaropartners\.es$ [NC]
  RewriteRule ^(.*)$ https://alfaropartners.es/$1 [R=301,L]

  # ---------------------------------------------------------------------------
  # SEO hardening (SDD alfaro-seo-hardening, Phase 3) -- http -> https, apex
  # ---------------------------------------------------------------------------
  # Verified empirically 8 sept 2026 with the Phase-1 probe (see the removed
  # X-Dbg-* block, kept below in a comment for the next time this needs
  # re-checking): on the apex vhost, %{HTTPS} was "off" on 3/3 real http
  # requests and "on" on 3/3 real https requests -- clean, stable signal.
  # The X-Forwarded-Proto/Protocol/Ssl headers were not: a different,
  # uncorrelated value on every single request, on both schemes. Not used.
  #
  # Scoped implicitly to the apex: by the time a request reaches this rule,
  # the www rule above has already redirected any www host away with [L], so
  # %{HTTP_HOST} here is always the apex. Do not copy this condition onto a
  # www-facing rule -- a live https://www request showed %{HTTPS} as (null)
  # on this host, so the signal does not hold there.
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://alfaropartners.es/$1 [R=301,L]
</IfModule>

# ---------------------------------------------------------------------------
# SEO hardening (SDD alfaro-seo-hardening, Phase 2) — compression + charset
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

AddDefaultCharset UTF-8

# ===========================================================================
# PROBE, RESOLVED -- kept only as a record (SDD alfaro-seo-hardening, Phase 1)
# ===========================================================================
# Ran 8 sept 2026, live against production. Result: %{HTTPS}e is the reliable
# signal on the apex vhost -- "off" on 3/3 real http requests, "on" on 3/3
# real https requests, clean. The X-Forwarded-Proto/Protocol/Ssl headers were
# not: a different, uncorrelated value on every single request. Phase 3 above
# uses %{HTTPS}, not X-Forwarded-*.
#
# If this ever needs re-running (host migration, proxy change in front of
# Apache): uncomment the block below, deploy this file ALONE, then from a
# machine outside the site:
#   curl -sI http://alfaropartners.es/  | rg -i x-dbg
#   curl -sI https://alfaropartners.es/ | rg -i x-dbg
# and re-comment it immediately after reading the result -- it must never
# stay live alongside real traffic.
#
# <IfModule mod_headers.c>
#   Header always set X-Dbg-Proto    "%{X-Forwarded-Proto}i"
#   Header always set X-Dbg-Protocol "%{X-Forwarded-Protocol}i"
#   Header always set X-Dbg-Ssl      "%{X-Forwarded-Ssl}i"
#   Header always set X-Dbg-Https    "%{HTTPS}e"
# </IfModule>
# ===========================================================================
