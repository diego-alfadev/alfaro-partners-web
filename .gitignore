# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# agent tooling (local, per-machine)
.atl/
.engram/

# working backups
*.bak

# comprimidos en assets: el kit de marca vive descomprimido en
# assets/brand-kit/, que es lo que se versiona y lo que se puede diffear. El
# .zip es el mismo contenido en binario y solo sirve para enviarlo por correo.
assets/**/*.zip

# comprimidos en assets: el contenido va descomprimido y versionado
# (assets/brand-kit/), no como zip. Un binario de MB en git no se diffea, no se
# revisa y duplica lo que ya esta al lado.
assets/**/*.zip
assets/**/*.tar
assets/**/*.tar.gz
assets/**/*.rar
